{
  "build": {
    "frontendDist": "target/desktop-e2e/frontend",
    "beforeBuildCommand": "npm run build -- --outDir src-tauri/target/desktop-e2e/frontend"
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "desktop-e2e",
          "description": "Desktop automation bridge enabled only by the isolated E2E build configuration.",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  }
}
