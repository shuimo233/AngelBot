# AngelBot 环境变量配置
# 复制此文件为 .env 并填入你的配置
# 优先级：环境变量 > UI 配置

# ============================================
# 主要 Provider 选择（填入一个即可）
# ============================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# OpenAI (GPT)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Google Gemini
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxx

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Azure OpenAI
# AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxx

# Mistral AI
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxx

# Together AI
# TOGETHER_API_KEY=xxxxxxxxxxxxxxxx

# xAI (Grok)
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxx

# OpenRouter (访问 200+ 模型)
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx

# ============================================
# 本地 Provider
# ============================================

# Ollama（本地运行，无需 API Key）
# 设置为你实际的 Ollama 地址
OLLAMA_BASE_URL=http://localhost:11434/v1

# ============================================
# 说明
# ============================================
# 1. 同一时间只能使用一个 Provider
# 2. 系统会自动检测第一个找到的环境变量
# 3. 如果设置了环境变量，UI 配置将被忽略
# 4. Ollama 和 Claude CLI 是本地服务，不需要 API Key
# 5. 更多配置请参考文档
